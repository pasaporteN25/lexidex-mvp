__pycache__/
*.pyc
node_modules/

# Estado local regenerable, no versionado (ver docs/decisions/0002-personal-catalog-overlay.md)
data/user/*.sqlite
/lexidex.sqlite

# Identidad del hub de sincronizacion. Es de esta instalacion, como el device_id de un telefono:
# versionarla haria que dos copias del repo se presenten como el mismo hub.
data/user/*.hub.json

# Salida de Graphify, herramienta de desarrollo opcional (ver docs/graphify-evaluation.md)
graphify-out/

# Copia del almacen de certificados del JDK con el CA de Avast, para que Gradle pueda resolver
# dependencias en esta maquina. Es local y especifica del equipo: no va al repositorio.
work/cacerts-with-avast
