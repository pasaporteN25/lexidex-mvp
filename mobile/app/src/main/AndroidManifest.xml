<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Solo para buscar terminos en fuentes externas al crearlos (ADR 0003). El catalogo, la
        busqueda y todo el resto siguen funcionando sin conexion: la red es un camino adicional,
        nunca uno obligatorio.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Solo para escanear el codigo de emparejamiento. `required=false` a proposito: pegar el
         codigo hace lo mismo, asi que un telefono sin camara no tiene por que quedar afuera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".LexidexApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lexidex">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lexidex.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
